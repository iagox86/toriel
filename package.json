    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@gotgenes/pi-permission-system": "42.0.0",
    "@juicesharp/rpiv-ask-user-question": "2.15.0",
