#!/bin/sh
# procs: list processes one per line with their REAL command line, for grepping.
#
#   procs [-i] [PATTERN]      processes whose full command line matches the extended regex PATTERN (all when omitted)
#   procs --leak [HOURS]      toriel/pi-related processes older than HOURS (default 12): daemons, pi children, test fakes
#
# Why not `ps | grep`: pi rewrites its process title, so `ps` shows just "pi" and the session file and flags
# are gone; /proc/<pid>/cmdline keeps the real argv. Each line is: PID PPID AGE USER COMMAND (the argv joined
# by spaces; kernel threads show their name in brackets). Age is d/h/m/s. It leaves out itself and the processes that started it.
# Needs only sh, ps and /proc (Linux).
set -eu

mode=match
insensitive=
hours=12
pattern=
while [ $# -gt 0 ]; do
  case $1 in
    --leak) mode=leak; shift; case ${1:-} in ''|*[!0-9]*) ;; *) hours=$1; shift ;; esac ;;
    -i) insensitive=1; shift ;;
    --) shift; if [ $# -gt 0 ]; then pattern=$1; shift; fi; break ;;
    -h|--help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "procs: unknown option $1 (try --help)" >&2; exit 2 ;;
    *) pattern=$1; shift ;;
  esac
done
if [ $# -gt 0 ]; then echo "procs: unexpected argument $1 (try --help)" >&2; exit 2; fi
if [ "$mode" = leak ] && [ -n "$pattern" ]; then echo "procs: --leak takes only a whole number of hours, not \"$pattern\"" >&2; exit 2; fi

# the processes that started this one (the shell, the tool that ran it) are left out: their command line holds the pattern
skip=" $$ "
p=$$
while [ "${p:-0}" -gt 1 ]; do
  p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ') || break
  [ -n "$p" ] && skip="$skip$p "
done
# Anchored so that the user's own tools never show up as leaks (an agent may be tempted to stop what this lists):
# pi children (their title is rewritten to a bare "pi"), pi-coding-agent's own cli.js, toriel's launcher and its
# daemon.ts/toriel.ts as a script argument, and the test fake. NOT any process that merely has "cli.js" or the
# toriel directory somewhere in its arguments (Claude Code, npm, a language server, git -C).
[ "$mode" = leak ] && pattern='^pi( |$)|pi-coding-agent/[^ ]*cli\.js|(^|[ /])bin/toriel( |$)|(^|[ ])[^ ]*/(daemon|toriel)\.ts( |$)|fake-pi\.mjs'
min_age=0
[ "$mode" = leak ] && min_age=$((hours * 3600))

human() {
  s=$1
  if [ "$s" -ge 86400 ]; then printf '%dd%dh' $((s / 86400)) $((s % 86400 / 3600))
  elif [ "$s" -ge 3600 ]; then printf '%dh%dm' $((s / 3600)) $((s % 3600 / 60))
  elif [ "$s" -ge 60 ]; then printf '%dm%ds' $((s / 60)) $((s % 60))
  else printf '%ds' "$s"; fi
}

# one snapshot first, so the helpers this script starts later (tr, grep: their command line holds the pattern) are not in it
snap=$(ps -eo pid=,ppid=,etimes=,user=,comm=)
printf '%s\n' "$snap" | while read -r pid ppid age user comm; do
  case $skip in *" $pid "*) continue ;; esac
  [ "$comm" = ps ] && continue
  [ "$age" -ge "$min_age" ] || continue
  # the redirect is inside the group: `<` is evaluated before a trailing 2>/dev/null would apply, so a process that vanished would print an error
  if cmd=$({ tr '\0' ' ' < "/proc/$pid/cmdline"; } 2>/dev/null) && [ -n "$cmd" ]; then
    while [ "${cmd% }" != "$cmd" ]; do cmd=${cmd% }; done # pi pads its rewritten title with spaces
  else
    cmd="[$comm]"
  fi
  if [ -n "$pattern" ]; then
    if [ -n "$insensitive" ]; then
      printf '%s\n' "$cmd" | grep -Eiq -- "$pattern" || continue
    else
      printf '%s\n' "$cmd" | grep -Eq -- "$pattern" || continue
    fi
  fi
  printf '%s %s %s %s %s\n' "$pid" "$ppid" "$(human "$age")" "$user" "$cmd"
done
