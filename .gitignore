# Generated dependencies (file: dep symlinks + npm bookkeeping)
node_modules/
# the bare pattern also matches node_modules as a SYMLINK, which the trailing-slash form does not
# - without it a worktree's dep symlink leaks back into the index via a git add -A (cb07df6, batch 18)
node_modules

# Runtime logs
*.log

# Session files from stray pi/fake-pi runs
*.jsonl

# Local worktrees used by the delegation workflow (never repo content)
.claude/

# Key/UI debug logs (TORIEL_KEYS=1)
logs/
